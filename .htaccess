Options -Indexes
DirectoryIndex public/index.php

RewriteEngine On

# Keep direct access to real files and folders working.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send application routes to the public front controller.
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
